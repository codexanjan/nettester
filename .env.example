# NetScope Production & Development Environment Variables

# Database Connection (Default SQLite for local dev, PostgreSQL for docker)
DATABASE_URL=sqlite+aiosqlite:///./speedtest.db
# PostgreSQL Example: postgresql+asyncpg://speedtest_user:speedtest_password@localhost:5432/speedtest_db

# Environment
ENV=development
DEBUG=false

# Allowed CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","*"]

# Speed Test Measurement Bounds
MAX_DOWNLOAD_CHUNK_SIZE_MB=8
MAX_DOWNLOAD_TIME_SECONDS=30
MAX_UPLOAD_SIZE_MB=100
MAX_CONCURRENT_TESTS=20

# Rate Limiting
RATE_LIMIT_PING=120/minute
RATE_LIMIT_DOWNLOAD=30/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_DEFAULT=60/minute

# Admin Secret Key Header
ADMIN_API_KEY=netscope-admin-secret-key-2026

# Optional External Keys
GEMINI_API_KEY=
IP_LOOKUP_API_KEY=
